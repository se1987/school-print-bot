# === LINE Messaging API ===
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# === Gemini API ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Google Calendar API ===
# scripts/authorize_google.py を実行して取得したJSONを設定
# 未設定の場合はカレンダー連携がスキップされる（他の機能は正常動作）
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# 登録先カレンダーID（省略時はプライマリカレンダー）
GOOGLE_CALENDAR_ID=primary

# === アプリ設定 ===
PORT=8000
# DB保存先（Docker使用時は /app/data/school_prints.db を推奨）
DB_PATH=school_prints.db

# === PostgreSQL（Cloud Run など、ディスクが揮発する環境向け。未設定なら上の SQLite を使う） ===
# 接続文字列。Supabase の場合は「Transaction pooler」（ポート 6543）のものを使う
DATABASE_URL=
# 既存の PostgreSQL に同居させる場合の専用スキーマ名（未設定なら接続ロールの既定スキーマ）
DB_SCHEMA=

# === 定期ジョブ（毎朝のリマインド・4月の進級） ===
# internal: プロセス内スケジューラーが実行（常時起動の環境向け。既定）
# external: 外部 cron が /cron/daily-reminder と /cron/advance-grades を POST する（スリープする環境向け）
SCHEDULER_MODE=internal
# external のとき必須。外部 cron は X-Cron-Secret ヘッダーにこの値を付ける（openssl rand -hex 32 で生成）
CRON_SECRET=
